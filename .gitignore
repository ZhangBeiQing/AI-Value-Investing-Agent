.ipynb_checkpoints/
*.txt
**/*.txt

!configs/prompt_flow/default_flow.json
!configs/prompt_flow/skill_flow.json
# 忽略项目中的所有PDF文件
**/*.pdf

# 临时文件/目录
test/
**/test_*
*.html
